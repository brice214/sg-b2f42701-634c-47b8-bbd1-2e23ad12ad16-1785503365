# Configuration SMTP pour l'envoi d'emails via le formulaire de contact
# Remplacer ces valeurs par celles de votre serveur SMTP

# Hôte du serveur SMTP (ex: mail.xeta-digital.com)
SMTP_HOST=mail.votre-serveur.com

# Port SMTP (587 pour TLS, 465 pour SSL, 25 non sécurisé)
SMTP_PORT=587

# Utiliser SSL/TLS (true pour port 465, false pour 587 ou 25)
SMTP_SECURE=false

# Identifiant SMTP (généralement votre adresse email)
SMTP_USER=contact@xeta-digital.com

# Mot de passe SMTP
SMTP_PASSWORD=votre_mot_de_passe_smtp

# Adresse email expéditeur (optionnel, utilise SMTP_USER par défaut)
SMTP_FROM=contact@xeta-digital.com