# Configuration SMTP pour l'envoi d'emails via le formulaire de contact
# Configuration pour Namecheap Private Email
# À configurer dans Vercel : Settings > Environment Variables

# Hôte du serveur SMTP Namecheap
SMTP_HOST=mail.privateemail.com

# Port SMTP (587 pour TLS, 465 pour SSL)
SMTP_PORT=587

# Utiliser SSL/TLS (false pour port 587 avec STARTTLS)
SMTP_SECURE=false

# Identifiant SMTP (votre adresse email complète)
SMTP_USER=contact@xeta-digital.com

# Mot de passe SMTP de votre compte Namecheap Private Email
SMTP_PASSWORD=votre_mot_de_passe_smtp

# Adresse email expéditeur (optionnel, utilise SMTP_USER par défaut)
SMTP_FROM=contact@xeta-digital.com

# Google reCAPTCHA v3
RECAPTCHA_SITE_KEY=6LeCAYQtAAAAACPhnsoYKwhLfprUW8sw2Wb3UUBH
RECAPTCHA_SECRET_KEY=6LeCAYQtAAAAAKEtVIgs0XWFcp-1AVBfCjOlRNIe